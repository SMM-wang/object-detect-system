FLASK_ENV=development
HOST=0.0.0.0
PORT=8080
SECRET_KEY=change-me
JWT_EXPIRES_SECONDS=86400
DATABASE_URL=sqlite:///dev.db
MYSQL_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/aerial_detect?charset=utf8mb4
USE_MYSQL=false
UPLOAD_MAX_BYTES=524288000
MODEL_BACKEND=onnx
MODEL_DIR=model
MODEL_PATH=yolov11n.onnx
MODEL_VERSION=yolov11n.onnx
ALLOW_MOCK_DETECTOR=false
DETECTOR_MAX_CONCURRENCY=1
DETECTOR_ACQUIRE_TIMEOUT_SECONDS=0.1
VIDEO_MAX_PROCESSED_FRAMES=300
DEFAULT_FRAME_INTERVAL=5
